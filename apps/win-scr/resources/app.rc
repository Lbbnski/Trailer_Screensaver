#include <winuser.h>

// Embeds app.manifest so the binary is per-monitor-v2 DPI aware without
// needing an external .manifest file shipped alongside the .scr — see
// app.manifest for why that matters for multi-monitor FullscreenController.
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Steam Trailer Screensaver Project"
            VALUE "FileDescription", "Steam Trailer Screensaver"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "SteamTrailerScreensaver"
            VALUE "OriginalFilename", "SteamTrailerScreensaver.scr"
            VALUE "ProductName", "Steam Trailer Screensaver"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
